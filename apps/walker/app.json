{
  "expo": {
    "name": "DOJO WALK Walker",
    "slug": "dojo-walk-walker",
    "scheme": "dojowalkwalker",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "DOJO WALK uses your location to record arrival at an assigned dog walk."
        }
      ]
    ],
    "android": {
      "package": "com.dojowalk.walker"
    }
  }
}
